{
    "name": "tobento/service-migration",
    "version": "2.0",
    "type": "library",
    "description": "A mirgation manager for any PHP application.",
    "keywords": [
        "tobento",
        "package",
        "migration",
        "install",
        "uninstall"
	],
    "homepage": "https://www.tobento.ch",
    "license": "MIT",
    "authors": [
        {
            "name": "Tobias Strub",
            "email": "info@tobento.ch",
            "homepage": "https://www.tobento.ch"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,    
    "require": {
        "php": ">=8.4",
        "psr/container": "^2.0",
        "tobento/service-autowire": "^2.0",
        "tobento/service-filesystem": "^2.0",
        "tobento/service-file-creator": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.3",
        "vimeo/psalm": "^6.13",
        "tobento/service-container": "^2.0"
    },   
    "autoload": {
        "psr-4": {
            "Tobento\\Service\\Migration\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tobento\\Service\\Migration\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit --testdox --colors=always",
        "psalm": "vendor/bin/psalm"
    }
}